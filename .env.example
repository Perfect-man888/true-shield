# =========================================================
# True Shield - Environment Variable Template
# Copy this file to .env before running the project.
# Never commit the real .env file.
# =========================================================

# Application
APP_NAME=true-shield
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=true_shield
POSTGRES_USER=true_shield
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=true-shield
MINIO_SECURE=false

# JWT
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Risk engine versions
RULE_VERSION=v0.1.0
MODEL_BUNDLE_VERSION=rules-only-v0.1.0

# Frontend
FRONTEND_URL=http://localhost:5173