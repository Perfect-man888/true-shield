# =========================================================
# True Shield - Environment Variable Template
# Copy this file to .env before running the project.
# Never commit the real .env file.
# =========================================================

# Application
APP_NAME=true-shield
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=true_shield
POSTGRES_USER=true_shield
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=true-shield
MINIO_SECURE=false

# JWT
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Risk engine versions
RULE_VERSION=v0.1.0
MODEL_BUNDLE_VERSION=rules-only-v0.1.0

# Frontend
FRONTEND_URL=http://localhost:5173
# Notification delivery
NOTIFICATION_PROVIDER=simulated
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# Password reset
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_RESEND_INTERVAL_SECONDS=60
PASSWORD_RESET_MAX_FAILED_ATTEMPTS=5

# Firebase Cloud Messaging
# 先将 Firebase 服务账号 JSON 放到 secrets/firebase-service-account.json。
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=secrets/firebase-service-account.json


# Local voice transcription (faster-whisper)
# 首次执行 scripts/preload_voice_model.py 时会下载模型；后续可离线运行。
VOICE_TRANSCRIPTION_ENABLED=true
VOICE_FUNASR_MODEL=iic/SenseVoiceSmall
VOICE_FUNASR_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
VOICE_FUNASR_HUB=ms
VOICE_FUNASR_DEVICE=cpu
VOICE_FUNASR_CACHE_ROOT=models/modelscope
VOICE_FUNASR_CPU_THREADS=4
VOICE_FUNASR_BATCH_SIZE_SECONDS=60
VOICE_AUDIO_MAX_BYTES=20971520
VOICE_AUDIO_MAX_DURATION_SECONDS=180
