{
    admin off
}

{$PUBLIC_HOST} {
    encode zstd gzip

    request_body {
        max_size 25MB
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), geolocation=(), microphone=()"
    }

    reverse_proxy api:8000

    log {
        output stdout
        format console
    }
}
