# Public entry. With a domain, use api.example.com and point its A record here.
# Without a domain, first use http://192.144.143.48.
PUBLIC_HOST=http://192.144.143.48

APP_NAME=true-shield
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

POSTGRES_DB=true_shield
POSTGRES_USER=true_shield
POSTGRES_PASSWORD=replace_with_random_hex

REDIS_PASSWORD=

MINIO_ACCESS_KEY=true_shield_storage
MINIO_SECRET_KEY=replace_with_random_hex
MINIO_BUCKET=true-shield
MINIO_SECURE=false

JWT_SECRET_KEY=replace_with_at_least_64_random_hex_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

RULE_VERSION=v0.1.0
MODEL_BUNDLE_VERSION=rules-only-v0.1.0

# Android does not use browser CORS, but keep this set to the actual public origin.
FRONTEND_URL=http://192.144.143.48

NOTIFICATION_PROVIDER=simulated
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_RESEND_INTERVAL_SECONDS=60
PASSWORD_RESET_MAX_FAILED_ATTEMPTS=5

FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json

# Full-feature deployment keeps local voice transcription enabled. On the
# current 2 GB server it runs with one CPU thread and may be slow during the
# first model download/load; 4 GB or more is recommended for stable demos.
VOICE_TRANSCRIPTION_ENABLED=true
VOICE_FUNASR_MODEL=iic/SenseVoiceSmall
VOICE_FUNASR_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
VOICE_FUNASR_HUB=ms
VOICE_FUNASR_DEVICE=cpu
VOICE_FUNASR_CPU_THREADS=1
VOICE_FUNASR_BATCH_SIZE_SECONDS=15
VOICE_AUDIO_MAX_BYTES=20971520
VOICE_AUDIO_MAX_DURATION_SECONDS=180
